<h1 class="page-title">代車貸出登録</h1>

<% if @rental.errors.any? %>
  <div class="card card-error">
    <p class="card-error-title">入力内容を確認してください</p>
    <ul class="card-error-list">
      <% @rental.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<% if @repair.present? %>
  <div class="card card-mb">
    <p><strong>顧客名:</strong> <%= @repair.customer_name %></p>
    <p>
      <strong>車両:</strong>
      <%= @repair.car_model %>（<%= @repair.car_number %>）
    </p>
  </div>
<% end %>

<div class="card">
  <%= form_with model: @rental, local: true do |f| %>

    <% if @repair.present? %>
      <%= f.hidden_field :repair_id, value: @repair.id %>
    <% else %>
      <div>
        <%= f.label :customer_name, "顧客名", class: "form-label" %>
        <%= f.text_field :customer_name, class: "form-input", placeholder: "例：田中 太郎" %>
      </div>
    <% end %>

    <div>
      <%= f.label :loaner_car_id, "代車選択", class: "form-label" %>
      <%= f.collection_select :loaner_car_id, @loaner_cars, :id, :name, {}, class: "form-select" %>
    </div>

    <div>
      <%= label_tag :parking_lot, "駐車場", class: "form-label" %>
      <%= select_tag :parking_lot,
            options_for_select(LoanerCar::PARKING_LOTS.map { |k, v| [v, k] }, @rental.loaner_car&.parking_lot),
            include_blank: "未設定", class: "form-select" %>
    </div>

    <div>
      <%= f.label :reason, "理由", class: "form-label" %>
      <%= f.text_field :reason, class: "form-input", placeholder: "例：車検、修理、点検" %>
    </div>

    <div data-controller="date-range">
      <label class="form-label">貸出期間</label>
      <input type="text" class="form-input" placeholder="開始日 〜 終了日"
             data-date-range-target="display" readonly style="cursor:pointer;">
      <%= f.hidden_field :start_date, data: { "date-range-target": "startDate" } %>
      <%= f.hidden_field :end_date,   data: { "date-range-target": "endDate" } %>
    </div>

    <div class="form-actions">
      <%= f.submit "貸出登録", class: "btn-primary" %>
      <% if @repair.present? %>
        <%= link_to "修理詳細に戻る", repair_path(@repair), class: "btn-outline" %>
      <% else %>
        <%= link_to "代車一覧に戻る", loaner_cars_path(tab: "grid"), class: "btn-outline" %>
      <% end %>
    </div>

  <% end %>
</div>
