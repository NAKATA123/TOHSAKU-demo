<div class="page-container">
  <div class="page-header">
    <div>
      <h1 class="page-title">
        <% if @loaner_car %>
          <%= @loaner_car.name %> の貸出履歴
        <% else %>
          貸出一覧
        <% end %>
      </h1>

      <p class="muted">
        <% if @loaner_car %>
          <%= @loaner_car.name %> の貸出状況を確認できます。
        <% else %>
          代車の貸出履歴を一覧で確認できます。
        <% end %>
      </p>
    </div>

    <div class="page-actions">
      <%= link_to "代車一覧へ戻る", loaner_cars_path, class: "btn-outline" %>
    </div>
  </div>

  <% if @rentals.any? %>
    <table class="repair-table">
      <thead>
        <tr>
          <th>代車</th>
          <th>顧客</th>
          <th>車両</th>
          <th>開始日</th>
          <th>終了日</th>
          <th>登録日時</th>
          <th>登録者</th>
        </tr>
      </thead>
      <tbody>
        <% @rentals.each do |rental| %>
          <tr>
            <td><%= rental.loaner_car.name %></td>
            <td><%= rental.repair&.car&.customer&.name || "顧客情報なし" %></td>
            <td>
              <%= rental.repair&.car&.car_model %>
              （<%= rental.repair&.car&.car_number %>）
            </td>
            <td><%= rental.start_date.strftime("%Y/%m/%d") %></td>
            <td><%= rental.end_date.strftime("%Y/%m/%d") %></td>
            <td><%= rental.created_at.strftime("%Y/%m/%d %H:%M") %></td>
            <td><%= rental.created_by&.name || "-" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <div class="card empty-state">
      <p class="muted">貸出履歴はまだありません。</p>
    </div>
  <% end %>
</div>
