<div class="staff-login">
  <div class="staff-login-card">
    <p class="staff-login-eyebrow">Staff Access</p>
    <%= image_tag "logo.png", alt: "TOHSAKU", class: "staff-login-logo" %>
    <p class="staff-login-tagline">車修理工場 業務管理システム</p>

    <% if flash[:alert] %>
      <div class="staff-login-alert"><%= flash[:alert] %></div>
    <% end %>

    <%= form_with url: login_path, method: :post do |f| %>
      <p class="staff-login-field-label">社員番号</p>
      <%= f.text_field :employee_number, class: "staff-login-input",
            placeholder: "0000",
            autocomplete: "off",
            maxlength: 4,
            inputmode: "numeric",
            autofocus: true %>
      <p class="staff-login-hint">誕生日4桁を入力</p>

      <button type="submit" class="staff-login-btn">ログイン</button>
    <% end %>
  </div>
</div>
