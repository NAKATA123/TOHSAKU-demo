<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for?(:title) ? yield(:title) : "TOHSAKU" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <meta name="vapid-public-key" content="<%= ENV['VAPID_PUBLIC_KEY'] %>">
    <link rel="manifest" href="/manifest.json">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="TOHSAKU">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <meta name="theme-color" content="#0a1a20">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&family=IBM+Plex+Sans+JP:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/ja.js"></script>
  </head>

  <body>

  <% if logged_in? %>
    <header class="app-header">
      <div class="header-inner">

        <div class="brand">
          <%= link_to root_path, class: "brand-link" do %>
            <%= image_tag "logo.png", alt: "TOHSAKU", class: "brand-logo" %>
          <% end %>
        </div>

        <div class="header-divider"></div>

        <% if false %>
        <nav class="nav">
          <%= link_to "修理", repairs_path, class: "nav-link #{'active' if current_page?(repairs_path)}" %>
          <%= link_to "代車", loaner_cars_path, class: "nav-link #{'active' if current_page?(loaner_cars_path)}" %>
          <%= link_to "設定", settings_path, class: "nav-link #{'active' if current_page?(settings_path)}" %>
        </nav>
        <% end %>

        <div class="header-right">
          <span class="header-user">
            <span class="header-user-role"><%= current_user.admin? ? "ADMIN" : "STAFF" %></span>
          </span>
          <%= link_to "⚙️", settings_path, class: "settings-icon-btn #{'active' if current_page?(settings_path)}", title: "設定" %>
          <button id="push-toggle-btn" class="push-btn" data-subscribed="false" title="通知OFF">
            <span class="push-btn-icon">🔕</span><span class="push-btn-label">通知OFF</span>
          </button>
          <%= button_to logout_path, method: :delete, class: "logout-btn", title: "ログアウト" do %>
            <span class="logout-btn-icon">🚪</span><span class="logout-btn-label">ログアウト</span>
          <% end %>
        </div>

      </div>
    </header>
  <% end %>

  <main class="main-content">
    <% if flash[:notice] %>
      <div class="flash flash-notice"><%= flash[:notice] %></div>
    <% end %>
    <% if flash[:alert] %>
      <div class="flash flash-alert"><%= flash[:alert] %></div>
    <% end %>
    <%= yield %>
  </main>

  </body>
</html>
