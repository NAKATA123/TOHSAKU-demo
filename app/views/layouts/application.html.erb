<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for?(:title) ? yield(:title) : "TOHSAKU" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <meta name="vapid-public-key" content="<%= ENV['VAPID_PUBLIC_KEY'] %>">
    <link rel="manifest" href="/manifest.json">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="TOHSAKU">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <meta name="theme-color" content="#0a1a20">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&family=IBM+Plex+Sans+JP:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/ja.js"></script>
  </head>

  <body>

  <% if logged_in? %>
    <header class="app-header">
      <div class="header-inner">

        <div class="brand">
          <%= link_to root_path, class: "brand-link" do %>
            <%= image_tag "logo.png", alt: "TOHSAKU", class: "brand-logo" %>
          <% end %>
        </div>

        <div class="header-divider"></div>

        <nav class="nav">
          <%= link_to "修理", repairs_path, class: "nav-link #{'active' if current_page?(repairs_path)}" %>
          <%= link_to "代車", loaner_cars_path, class: "nav-link #{'active' if current_page?(loaner_cars_path)}" %>
          <% if current_user&.admin? %>
            <%= link_to "ユーザー管理", users_path, class: "nav-link #{'active' if current_page?(users_path)}" %>
          <% end %>
        </nav>

        <div class="header-right">
          <span class="header-user">
            <span class="header-user-role"><%= current_user.admin? ? "ADMIN" : "STAFF" %></span>
          </span>
          <button id="push-toggle-btn" class="push-btn" data-subscribed="false">🔕 通知OFF</button>
          <%= button_to "ログアウト", logout_path, method: :delete, class: "logout-btn" %>
        </div>

      </div>
    </header>
  <% end %>

  <main style="max-width:1200px; margin:24px auto; padding:0 24px;">
    <% if flash[:notice] %>
      <div class="flash flash-notice"><%= flash[:notice] %></div>
    <% end %>
    <% if flash[:alert] %>
      <div class="flash flash-alert"><%= flash[:alert] %></div>
    <% end %>
    <%= yield %>
  </main>

  </body>
</html>
