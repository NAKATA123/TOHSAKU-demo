<div class="login-page">
  <div class="login-card">

    <div class="login-header">
      <h1 class="login-title">ユーザー編集</h1>
    </div>

    <% if @user.errors.any? %>
      <div class="login-alert">
        <ul style="margin:0; padding-left:16px;">
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: @user, class: "login-form" do |f| %>

      <div>
        <%= f.label :name, "名前", class: "form-label" %>
        <%= f.text_field :name, class: "form-input" %>
      </div>

      <div>
        <%= f.label :employee_number, "社員番号（誕生日4桁）", class: "form-label" %>
        <%= f.text_field :employee_number, class: "form-input",
              placeholder: "例：0818",
              maxlength: 4,
              inputmode: "numeric" %>
      </div>

      <div>
        <%= f.label :role, "権限", class: "form-label" %>
        <%= f.select :role,
              [["従業員", "employee"], ["管理者", "admin"]],
              {},
              class: "form-select" %>
      </div>

      <%= f.submit "更新する", class: "btn-primary login-btn" %>

      <p class="login-register">
        <%= link_to "設定に戻る", settings_path, class: "login-link" %>
      </p>

    <% end %>

  </div>
</div>
