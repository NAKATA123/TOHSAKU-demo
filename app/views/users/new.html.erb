<div class="login-page">
  <div class="login-card">

    <div class="login-header">
      <h1 class="login-title">アカウント作成</h1>
      <p class="login-subtitle">
        TOHSAKUの業務管理アカウントを登録します。
      </p>
    </div>

    <% if @user.errors.any? %>
      <div class="login-alert">
        <ul style="margin:0; padding-left:16px;">
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: @user, class: "login-form" do |f| %>

      <div>
        <%= f.label :name, "名前", class: "form-label" %>
        <%= f.text_field :name, class: "form-input", placeholder: "例：田中 太郎" %>
      </div>

      <div>
        <%= f.label :employee_number, "社員番号（誕生日4桁）", class: "form-label" %>
        <%= f.text_field :employee_number, class: "form-input",
              placeholder: "例：0818",
              maxlength: 4,
              inputmode: "numeric" %>
      </div>

      <div>
        <%= f.label :email, "メールアドレス", class: "form-label" %>
        <%= f.email_field :email,
              class: "form-input",
              placeholder: "example@email.com" %>
      </div>

      <div>
        <%= f.label :password, "パスワード", class: "form-label" %>
        <%= f.password_field :password,
              class: "form-input",
              placeholder: "6文字以上" %>
      </div>

      <div>
        <%= f.label :password_confirmation, "パスワード（確認）", class: "form-label" %>
        <%= f.password_field :password_confirmation,
              class: "form-input" %>
      </div>

      <div>
        <%= f.label :role, "権限", class: "form-label" %>
        <%= f.select :role,
              [["従業員", "employee"], ["管理者", "admin"]],
              {},
              class: "form-select" %>
      </div>

      <%= f.submit "アカウント作成", class: "btn-primary login-btn" %>

      <p class="login-register">
        <%= link_to "ユーザー一覧に戻る", users_path, class: "login-link" %>
      </p>

    <% end %>

  </div>
</div>
