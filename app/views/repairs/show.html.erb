<h1 class="page-title">修理詳細</h1>

<div class="card card-mb">
  <p><strong>顧客名:</strong> <%= @repair.customer_name %></p>
  <p>
    <strong>車両:</strong>
    <%= @repair.car_model %>（<%= @repair.car_number %>）
  </p>
  <p class="repair-status-row">
    <strong>ステータス:</strong>
    <span class="status-badge <%= @repair.status %>">
      <%= t("enums.repair.status.#{@repair.status}") %>
    </span>
    <% if @repair.next_status %>
      <%= button_to @repair.next_status_label,
            update_status_repair_path(@repair),
            method: :patch,
            params: { status: @repair.next_status },
            class: "btn-status-next btn-status-#{@repair.next_status} btn-status-lg" %>
    <% end %>
  </p>
</div>

<div class="card">
  <p><strong>受付日:</strong> <%= @repair.received_at&.strftime("%Y/%m/%d") || "未登録" %></p>
  <% if @repair.completed_at %>
    <p><strong>完了日:</strong> <%= @repair.completed_at.strftime("%Y/%m/%d") %></p>
  <% end %>
  <p><strong>修理内容</strong></p>
  <p style="white-space: pre-wrap;"><%= @repair.description %></p>

  <div class="form-actions">
    <%= link_to "代車を貸す", new_rental_path(repair_id: @repair.id), class: "btn-primary" %>
    <%= link_to "編集", edit_repair_path(@repair), class: "btn-outline" %>
    <%= link_to "一覧へ戻る", repairs_path, class: "btn-outline" %>
    <%= link_to "削除", repair_path(@repair),
      data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" },
      class: "btn-danger" %>
  </div>
</div>
