<h1 class="page-title">修理登録</h1>

<div class="card">
  <%= form_with model: @repair, local: true do |f| %>

    <div>
      <%= f.label :customer_name, "顧客名", class: "form-label" %>
      <%= f.text_field :customer_name, class: "form-input", placeholder: "例：田中 太郎" %>
    </div>

    <div>
      <%= f.label :car_model, "車種", class: "form-label" %>
      <%= f.text_field :car_model, class: "form-input" %>
    </div>

    <div>
      <%= f.label :car_number, "ナンバー", class: "form-label" %>
      <%= f.text_field :car_number, class: "form-input" %>
    </div>

    <div>
      <%= f.label :description, "修理内容", class: "form-label" %>
      <%= f.text_area :description, class: "form-textarea" %>
    </div>

    <div>
      <%= f.label :status, "ステータス", class: "form-label" %>
      <%= f.select :status,
        Repair.statuses.keys.map { |k| [t("enums.repair.status.#{k}"), k] },
        {},
        class: "form-select" %>
    </div>

    <div>
      <%= f.label :received_at, "受付日", class: "form-label" %>
      <%= f.date_field :received_at, class: "form-input" %>
    </div>

    <div style="margin-top:20px;">
      <%= f.submit "登録", class: "btn-primary" %>
    </div>

  <% end %>
</div>
