<div class="page-header">
  <div>
    <h1 class="page-title">修理一覧</h1>
  </div>
  <div class="page-actions">
    <%= link_to "＋修理登録", new_repair_path, class: "btn-primary" %>
  </div>
</div>

<div class="status-filter">
  <%= link_to repairs_path,
        class: "filter-btn #{'active' if @status_filter.nil?}" do %>
    すべて
    <span class="filter-count"><%= @counts[:all] %></span>
  <% end %>
  <%= link_to repairs_path(status: :reception),
        class: "filter-btn reception #{'active' if @status_filter == 'reception'}" do %>
    受付中
    <span class="filter-count"><%= @counts[:reception] %></span>
  <% end %>
  <%= link_to repairs_path(status: :working),
        class: "filter-btn working #{'active' if @status_filter == 'working'}" do %>
    作業中
    <span class="filter-count"><%= @counts[:working] %></span>
  <% end %>
  <%= link_to repairs_path(status: :completed),
        class: "filter-btn completed #{'active' if @status_filter == 'completed'}" do %>
    完了
    <span class="filter-count"><%= @counts[:completed] %></span>
  <% end %>
</div>

<% if @repairs.any? %>

  <%# ===== PCテーブル ===== %>
  <table class="repair-table repair-table--pc">
    <thead>
      <tr>
        <th>受付日</th>
        <th>顧客名</th>
        <th>車両</th>
        <th>修理内容</th>
        <th>ステータス</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @repairs.each do |repair| %>
        <tr class="table-row-link" onclick="location.href='<%= repair_path(repair) %>'">
          <td><%= repair.received_at&.strftime("%Y/%m/%d") || "-" %></td>
          <td><%= repair.customer_name %></td>
          <td><%= repair.car_model %>（<%= repair.car_number %>）</td>
          <td><%= truncate(repair.description, length: 20) %></td>
          <td>
            <span class="status-badge <%= repair.status %>">
              <%= t("enums.repair.status.#{repair.status}") %>
            </span>
          </td>
          <td class="repair-actions" onclick="event.stopPropagation()">
            <% if repair.next_status %>
              <%= button_to repair.next_status_label,
                    update_status_repair_path(repair),
                    method: :patch,
                    params: { status: repair.next_status },
                    class: "btn-status-next btn-status-#{repair.next_status}" %>
            <% end %>
            <%= link_to "詳細", repair_path(repair), class: "btn-outline" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <%# ===== スマホカード ===== %>
  <div class="repair-cards">
    <% @repairs.each do |repair| %>
      <a href="<%= repair_path(repair) %>" class="repair-card">
        <div class="repair-card-header">
          <div>
            <span class="repair-card-name"><%= repair.customer_name %></span>
            <span class="repair-card-car"><%= repair.car_model %>（<%= repair.car_number %>）</span>
          </div>
          <span class="status-badge <%= repair.status %>">
            <%= t("enums.repair.status.#{repair.status}") %>
          </span>
        </div>
        <% if repair.description.present? %>
          <div class="repair-card-desc"><%= truncate(repair.description, length: 40) %></div>
        <% end %>
        <div class="repair-card-footer">
          <span class="muted"><%= repair.received_at&.strftime("%Y/%m/%d") || "受付日未登録" %></span>
          <% if repair.next_status %>
            <%= button_to repair.next_status_label,
                  update_status_repair_path(repair),
                  method: :patch,
                  params: { status: repair.next_status },
                  class: "btn-status-next btn-status-#{repair.next_status}",
                  form: { "data-turbo" => "false" } %>
          <% end %>
        </div>
      </a>
    <% end %>
  </div>

  <%= paginate @repairs %>
<% else %>
  <div class="card empty-state">
    <p class="muted">修理はまだ登録されていません。</p>
  </div>
<% end %>
