<div class="page-container">

  <div class="page-header">
    <div>
      <h1 class="page-title">車両詳細</h1>
      <p class="muted">登録されている車両情報です</p>
    </div>

    <div class="page-actions">
      <%= link_to "＋ 修理追加",
          new_customer_car_repair_path(@car.customer, @car),
          class: "btn-primary" %>

      <%= link_to "編集",
          edit_customer_car_path(@car.customer, @car),
          class: "btn-outline" %>

      <%= link_to "顧客詳細へ戻る", customer_path(@car.customer), class: "btn-outline" %>
      <%= link_to "削除",
          customer_car_path(@car.customer, @car),
          class: "btn-danger",
          data: {
            turbo_method: :delete,
            turbo_confirm: "本当に削除しますか？"
          } %>
    </div>
  </div>

  <div class="card detail-card">
    <div class="detail-list">

      <div class="detail-row">
        <p class="detail-label">顧客名</p>
        <p class="detail-value"><%= @car.customer.name %></p>
      </div>

      <div class="detail-row">
        <p class="detail-label">車種</p>
        <p class="detail-value"><%= @car.car_model %></p>
      </div>

      <div class="detail-row">
        <p class="detail-label">ナンバー</p>
        <p class="detail-value"><%= @car.car_number %></p>
      </div>

    </div>
  </div>

  <div class="section-block">
    <h2 class="section-title">修理履歴</h2>

    <% if @repairs.any? %>
      <table class="repair-table">
        <thead>
          <tr>
            <th>受付日</th>
            <th>修理内容</th>
            <th>ステータス</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @repairs.each do |repair| %>
            <tr>
              <td><%= repair.received_at&.strftime("%Y/%m/%d") || "-" %></td>
              <td><%= truncate(repair.description, length: 30) %></td>
              <td>
                <span class="status-badge <%= repair.status %>">
                  <%= t("enums.repair.status.#{repair.status}") %>
                </span>
              </td>
              <td><%= link_to "詳細", repair_path(repair), class: "btn-outline" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="card empty-state">
        <p class="muted">修理履歴はまだありません。</p>
      </div>
    <% end %>
  </div>

</div>
