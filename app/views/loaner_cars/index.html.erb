<div class="page-container" data-controller="loaner-calendar">

  <h1 class="page-title">代車管理</h1>

  <div class="tab-nav">
    <button class="tab-btn active"
        data-tab="grid"
        data-loaner-calendar-target="tab"
        data-action="click->loaner-calendar#switch">
      カレンダー
    </button>

    <button class="tab-btn"
        data-tab="list"
        data-loaner-calendar-target="tab"
        data-action="click->loaner-calendar#switch">
      一覧
    </button>

    <%#
    <button class="tab-btn"
        data-tab="parking"
        data-loaner-calendar-target="tab"
        data-action="click->loaner-calendar#switch">
      駐車場
    </button>
    %>
  </div>

  <%# ===== 一覧タブ ===== %>
  <div id="tab-list"
       class="tab-content"
       data-panel="list"
       data-loaner-calendar-target="panel">

    <h2 class="section-title">貸出登録履歴</h2>

    <% if @registration_history.any? %>
      <div class="table-scroll">
        <table class="repair-table">
          <thead>
            <tr>
              <th>代車</th>
              <th>期間</th>
              <th>登録者</th>
            </tr>
          </thead>
          <tbody>
            <% @registration_history.each do |r| %>
              <tr class="table-row-link" onclick="location.href='<%= rental_path(r) %>'">
                <td><%= r.loaner_car.name %></td>
                <td style="white-space:nowrap">
                  <%= r.start_date.strftime("%m/%d") %> 〜
                  <%= r.end_date.strftime("%m/%d") %>
                </td>
                <td>
                  <%= r.created_by&.name || "-" %>
                  <span style="display:block; font-size:11px; font-weight:600; color:#94a3b8; margin-top:2px;">
                    <%= r.created_at.strftime("%m/%d %H:%M") %>
                  </span>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <%= paginate @registration_history, param_name: :registration_page, params: { tab: "list" } %>
    <% else %>
      <div class="card empty-state"><p class="muted">貸出登録の履歴はありません。</p></div>
    <% end %>

    <hr class="section-divider">

    <h2 class="section-title">貸出中</h2>

    <% if @current_rentals.any? %>
      <div class="table-scroll">
        <table class="repair-table">
          <tr>
            <th>代車</th>
            <th>期間</th>
            <th>顧客</th>
            <th class="col-meta">登録日時</th>
            <th class="col-meta">登録者</th>
            <th></th>
          </tr>
          <% @current_rentals.each do |r| %>
            <tr class="table-row-link" onclick="location.href='<%= rental_path(r) %>'">
              <td><%= r.loaner_car.name %></td>
              <td>
                <%= r.start_date.strftime("%m/%d") %>(<%= period_label(r.start_period) %>) 〜
                <%= r.end_date.strftime("%m/%d") %>(<%= period_label(r.end_period) %>)
              </td>
              <td>
                <%= r.customer_name.presence || r.repair&.customer_name || "なし" %>
              </td>
              <td class="col-meta muted"><%= r.created_at.strftime("%Y/%m/%d %H:%M") %></td>
              <td class="col-meta"><%= r.created_by&.name || "-" %></td>
              <td class="repair-actions" onclick="event.stopPropagation()">
                <% if r.end_date > Time.zone.today %>
                  <%= button_to "返却", returned_rental_path(r),
                        method: :patch,
                        params: { tab: "list" },
                        data: { turbo_confirm: "#{r.loaner_car.name}を返却済みにしますか？" },
                        class: "btn-outline btn-sm" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </table>
      </div>
    <% else %>
      <div class="card empty-state"><p class="muted">現在貸出中の代車はありません。</p></div>
    <% end %>

    <div class="section-header">
      <h2 class="section-title">貸出予定</h2>
      <div class="sort-toggle">
        <%= link_to "直近順", loaner_cars_path(upcoming_sort: "date", tab: "list"),
              class: "sort-btn #{'active' if @upcoming_sort == 'date'}" %>
        <%= link_to "新着順", loaner_cars_path(upcoming_sort: "created", tab: "list"),
              class: "sort-btn #{'active' if @upcoming_sort == 'created'}" %>
      </div>
    </div>

    <% if @upcoming_rentals.any? %>
      <div class="table-scroll">
        <table class="repair-table">
          <thead>
            <tr>
              <th>代車</th>
              <th>期間</th>
              <th>顧客</th>
              <th class="col-meta">登録日時</th>
              <th class="col-meta">登録者</th>
            </tr>
          </thead>
          <tbody>
            <% @upcoming_rentals.each do |r| %>
              <tr class="table-row-link" onclick="location.href='<%= rental_path(r) %>'">
                <td><%= r.loaner_car.name %></td>
                <td style="white-space:nowrap">
                  <%= r.start_date.strftime("%m/%d") %> 〜
                  <%= r.end_date.strftime("%m/%d") %>
                </td>
                <td><%= r.customer_name.presence || r.repair&.customer_name || "顧客情報なし" %></td>
                <td class="col-meta muted"><%= r.created_at.strftime("%Y/%m/%d %H:%M") %></td>
                <td class="col-meta"><%= r.created_by&.name || "-" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="card empty-state"><p class="muted">貸出予定はありません。</p></div>
    <% end %>

  </div>

  <%# ===== グリッドタブ ===== %>
  <div id="tab-grid"
       class="tab-content active"
       data-panel="grid"
       data-loaner-calendar-target="panel">

    <div class="loaner-grid-nav">
      <%= link_to "< 前の2週間", loaner_cars_path(start_date: (@grid_start - 14.days).to_s, tab: "grid", grid_sort: @grid_sort), class: "btn-outline btn-sm" %>
      <span class="loaner-grid-nav-period">
        <%= @grid_start.strftime("%Y/%m/%d") %> 〜 <%= @grid_end.strftime("%m/%d") %>
      </span>
      <%= link_to "次の2週間 >", loaner_cars_path(start_date: (@grid_start + 14.days).to_s, tab: "grid", grid_sort: @grid_sort), class: "btn-outline btn-sm" %>
      <%= link_to "今日", loaner_cars_path(tab: "grid", grid_sort: @grid_sort), class: "btn-outline btn-sm" %>
      <div class="sort-toggle">
        <%= link_to (@grid_sort == "desc" ? "貸出遠い順 ▾" : "貸出近い順 ▴"),
              loaner_cars_path(start_date: @grid_start.to_s, tab: "grid", grid_sort: @grid_sort == "desc" ? "asc" : "desc"),
              class: "sort-btn active" %>
      </div>
    </div>

    <div class="loaner-grid-wrap">
      <table class="loaner-grid">
        <thead>
          <tr>
            <th class="loaner-grid-car-header">代車</th>
            <% @grid_dates.each do |date| %>
              <%
                th_class = []
                th_class << "grid-today"   if date == Time.zone.today
                th_class << "grid-weekend" if date.saturday? || date.sunday? || HolidayJapan.check(date)
              %>
              <th class="<%= th_class.join(' ') %>">
                <%= date.strftime("%-m/%-d") %><br>
                <span class="grid-day-label"><%= %w[日 月 火 水 木 金 土][date.wday] %></span>
              </th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% if @grid_cars.any? %>
            <% @grid_cars.each do |car| %>
              <tr>
                <td class="loaner-grid-car loaner-grid-car--<%= car.parking_lot.presence || 'none' %>">
                  <%= link_to car.name, new_rental_path(loaner_car_id: car.id, tab: "grid"), class: "loaner-grid-car-link" %>
                  <% if car.parking_lot.present? %>
                    <span style="display:block; font-size:10px; font-weight:600; color:#94a3b8; margin-top:2px;"><%= LoanerCar::PARKING_LOTS[car.parking_lot] %></span>
                  <% end %>
                </td>
                <%
                  rentals_for_car = (@rental_by_car[car.id] || [])
                  consumed = []
                  half_rental = lambda do |d, slot_offset|
                    slot = d.jd * 2 + slot_offset
                    rentals_for_car.find { |r| r.start_slot <= slot && r.end_slot >= slot }
                  end
                  # そのdate/半日枠の1つ前の半日枠と同じ予約でなければ「そこが本当の開始」
                  starts_here = lambda do |d, slot_offset, rental|
                    prev = slot_offset.zero? ? half_rental.call(d - 1, 1) : half_rental.call(d, 0)
                    prev != rental
                  end
                  # ラベル表示用：本当の開始でなくても、表示中グリッドの一番最初のマスなら「開始」扱いにする
                  # （表示範囲より前から続く予約が、色だけでラベルが一切出ない状態を防ぐ）
                  label_starts_here = lambda do |d, slot_offset, rental|
                    (d == @grid_start && slot_offset.zero?) || starts_here.call(d, slot_offset, rental)
                  end

                  @grid_dates.each do |date|
                    next if consumed.include?(date)
                    am_rental = half_rental.call(date, 0)
                    pm_rental = half_rental.call(date, 1)

                    if am_rental != pm_rental
                      consumed << date
                      connects_next = pm_rental.present? && half_rental.call(date + 1, 0) == pm_rental
                      cell_class = "loaner-grid-half-cell"
                      cell_class += " loaner-grid-connect-next" if connects_next
                %>
                        <td class="<%= cell_class %>">
                          <div class="loaner-grid-half-row">
                            <% [[am_rental, 0], [pm_rental, 1]].each do |rental, offset| %>
                              <% if rental %>
                                <%
                                  half_class = "loaner-grid-half loaner-grid-half--booked"
                                  half_class += " loaner-grid-start" if starts_here.call(date, offset, rental)
                                %>
                                <div class="<%= half_class %>">
                                  <%= link_to rental_path(rental), class: "loaner-grid-rental-link loaner-grid-rental-link--half" do %>
                                    <% if label_starts_here.call(date, offset, rental) %>
                                      <% display_name = rental.customer_name.presence || rental.repair&.customer_name %>
                                      <span class="grid-rental-status"><%= display_name.presence || "貸出中" %></span>
                                    <% end %>
                                  <% end %>
                                </div>
                              <% else %>
                                <div class="loaner-grid-half loaner-grid-half--empty"></div>
                              <% end %>
                            <% end %>
                          </div>
                        </td>
                <%
                    elsif am_rental
                      rental = am_rental
                      end_in_grid = [rental.end_date, @grid_end].min
                      span_dates = (date..end_in_grid).to_a.take_while do |d|
                        half_rental.call(d, 0) == rental && half_rental.call(d, 1) == rental
                      end
                      consumed.concat(span_dates)
                      connects_next = half_rental.call(span_dates.last + 1, 0) == rental
                      cell_class = "loaner-grid-rented"
                      cell_class += " loaner-grid-connect-next" if connects_next
                      cell_class += " loaner-grid-start" if starts_here.call(span_dates.first, 0, rental)
                %>
                        <td colspan="<%= span_dates.size %>" class="<%= cell_class %>">
                          <%= link_to rental_path(rental), class: "loaner-grid-rental-link" do %>
                            <% if label_starts_here.call(span_dates.first, 0, rental) %>
                              <% display_name = rental.customer_name.presence || rental.repair&.customer_name %>
                              <span class="grid-rental-status"><%= display_name.presence || "貸出中" %></span>
                              <% if rental.reason.present? %>
                                <span class="grid-rental-customer"><%= rental.reason %></span>
                              <% end %>
                            <% end %>
                          <% end %>
                        </td>
                <%
                    else
                      cell_class = "loaner-grid-empty"
                      cell_class += " grid-today"   if date == Time.zone.today
                      cell_class += " grid-weekend" if date.saturday? || date.sunday? || HolidayJapan.check(date)
                %>
                        <td class="<%= cell_class %>"></td>
                <%
                    end
                  end
                %>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="<%= @grid_dates.size + 1 %>" class="loaner-grid-empty" style="text-align:center; padding: 24px; color: #94a3b8;">
                代車が登録されていません
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

  </div>

  <%# ===== 駐車場タブ ===== %>
  <div id="tab-parking"
       class="tab-content"
       data-panel="parking"
       data-loaner-calendar-target="panel">

    <% today = Time.zone.today %>
    <% (LoanerCar::PARKING_LOTS.keys + ["未設定"]).each do |lot| %>
      <% cars = @cars_by_lot[lot] || [] %>
      <div class="parking-lot-section">
        <div class="parking-lot-header">
          <span class="parking-badge parking-<%= lot %>">
            <%= LoanerCar::PARKING_LOTS[lot] || "未設定" %>
          </span>
          <span class="parking-lot-count"><%= cars.size %>台</span>
        </div>

        <% if cars.any? %>
          <table class="repair-table">
            <thead>
              <tr>
                <th>代車名</th>
                <th>ナンバー</th>
                <th>状況</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% cars.each do |car| %>
                <% active_rental = car.rentals.find { |r| r.start_date <= today && r.end_date >= today } %>
                <tr>
                  <td><%= car.name %></td>
                  <td><%= car.car_number %></td>
                  <td>
                    <% if active_rental %>
                      <span class="status-badge working">貸出中</span>
                    <% else %>
                      <span class="status-badge completed">空き</span>
                    <% end %>
                  </td>
                  <td>
                    <%= link_to "場所変更", edit_loaner_car_path(car), class: "btn-outline btn-sm" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <div class="card empty-state"><p class="muted">この駐車場に登録された代車はありません</p></div>
        <% end %>
      </div>
    <% end %>

  </div>

</div>
