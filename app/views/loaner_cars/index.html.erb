<div class="page-container" data-controller="loaner-calendar">

  <h1 class="page-title">代車管理</h1>

  <div class="tab-nav">
    <button class="tab-btn active"
        data-tab="grid"
        data-loaner-calendar-target="tab"
        data-action="click->loaner-calendar#switch">
      カレンダー
    </button>

    <button class="tab-btn"
        data-tab="list"
        data-loaner-calendar-target="tab"
        data-action="click->loaner-calendar#switch">
      一覧
    </button>

    <%#
    <button class="tab-btn"
        data-tab="parking"
        data-loaner-calendar-target="tab"
        data-action="click->loaner-calendar#switch">
      駐車場
    </button>
    %>

    <button class="tab-btn"
        data-tab="history"
        data-loaner-calendar-target="tab"
        data-action="click->loaner-calendar#switch">
      貸出履歴
    </button>
  </div>

  <%# ===== 一覧タブ ===== %>
  <div id="tab-list"
       class="tab-content"
       data-panel="list"
       data-loaner-calendar-target="panel">

    <h2 class="section-title">貸出中</h2>

    <% if @current_rentals.any? %>
      <table class="repair-table">
        <tr>
          <th>代車</th>
          <th>期間</th>
          <th>顧客</th>
          <th class="col-meta">登録日時</th>
          <th class="col-meta">登録者</th>
        </tr>
        <% @current_rentals.each do |r| %>
          <tr>
            <td><%= r.loaner_car.name %></td>
            <td>
              <%= r.start_date.strftime("%Y/%m/%d") %> 〜
              <%= r.end_date.strftime("%Y/%m/%d") %>
            </td>
            <td>
              <%= r.customer_name.presence || r.repair&.customer_name || "顧客情報なし" %>
            </td>
            <td class="col-meta muted"><%= r.created_at.strftime("%Y/%m/%d %H:%M") %></td>
            <td class="col-meta"><%= r.created_by&.name || "-" %></td>
          </tr>
        <% end %>
      </table>
    <% else %>
      <div class="card empty-state"><p class="muted">現在貸出中の代車はありません。</p></div>
    <% end %>

    <div class="section-header">
      <h2 class="section-title">貸出予定</h2>
      <div class="sort-toggle">
        <%= link_to "直近順", loaner_cars_path(upcoming_sort: "date", tab: "list"),
              class: "sort-btn #{'active' if @upcoming_sort == 'date'}" %>
        <%= link_to "新着順", loaner_cars_path(upcoming_sort: "created", tab: "list"),
              class: "sort-btn #{'active' if @upcoming_sort == 'created'}" %>
      </div>
    </div>

    <% if @upcoming_rentals.any? %>
      <div class="table-scroll">
        <table class="repair-table">
          <thead>
            <tr>
              <th>代車</th>
              <th>期間</th>
              <th>顧客</th>
              <th class="col-meta">登録日時</th>
              <th class="col-meta">登録者</th>
            </tr>
          </thead>
          <tbody>
            <% @upcoming_rentals.each do |r| %>
              <tr class="table-row-link" onclick="location.href='<%= rental_path(r) %>'">
                <td><%= r.loaner_car.name %></td>
                <td style="white-space:nowrap">
                  <span class="col-meta"><%= r.start_date.strftime("%Y/") %></span><%= r.start_date.strftime("%m/%d") %> 〜
                  <span class="col-meta"><%= r.end_date.strftime("%Y/") %></span><%= r.end_date.strftime("%m/%d") %>
                </td>
                <td><%= r.customer_name.presence || r.repair&.customer_name || "顧客情報なし" %></td>
                <td class="col-meta muted"><%= r.created_at.strftime("%Y/%m/%d %H:%M") %></td>
                <td class="col-meta"><%= r.created_by&.name || "-" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="card empty-state"><p class="muted">貸出予定はありません。</p></div>
    <% end %>

  </div>

  <%# ===== グリッドタブ ===== %>
  <div id="tab-grid"
       class="tab-content active"
       data-panel="grid"
       data-loaner-calendar-target="panel">

    <div class="loaner-grid-nav">
      <%= link_to "< 前の2週間", loaner_cars_path(start_date: (@grid_start - 14.days).to_s, tab: "grid", grid_sort: @grid_sort), class: "btn-outline btn-sm" %>
      <span class="loaner-grid-nav-period">
        <%= @grid_start.strftime("%Y/%m/%d") %> 〜 <%= @grid_end.strftime("%Y/%m/%d") %>
      </span>
      <%= link_to "次の2週間 >", loaner_cars_path(start_date: (@grid_start + 14.days).to_s, tab: "grid", grid_sort: @grid_sort), class: "btn-outline btn-sm" %>
      <%= link_to "今日", loaner_cars_path(tab: "grid", grid_sort: @grid_sort), class: "btn-outline btn-sm" %>
      <div class="sort-toggle">
        <%= link_to (@grid_sort == "desc" ? "貸出遠い順 ▾" : "貸出近い順 ▴"),
              loaner_cars_path(start_date: @grid_start.to_s, tab: "grid", grid_sort: @grid_sort == "desc" ? "asc" : "desc"),
              class: "sort-btn active" %>
      </div>
    </div>

    <div class="loaner-grid-wrap">
      <table class="loaner-grid">
        <thead>
          <tr>
            <th class="loaner-grid-car-header">代車</th>
            <% @grid_dates.each do |date| %>
              <%
                th_class = []
                th_class << "grid-today"   if date == Time.zone.today
                th_class << "grid-weekend" if date.saturday? || date.sunday?
              %>
              <th class="<%= th_class.join(' ') %>">
                <%= date.strftime("%-m/%-d") %><br>
                <span class="grid-day-label"><%= %w[日 月 火 水 木 金 土][date.wday] %></span>
              </th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% if @grid_cars.any? %>
            <% @grid_cars.each do |car| %>
              <tr>
                <td class="loaner-grid-car loaner-grid-car--<%= car.parking_lot.presence || 'none' %>">
                  <%= link_to car.name, new_rental_path(loaner_car_id: car.id, tab: "grid"), class: "loaner-grid-car-link" %>
                  <% if car.parking_lot.present? %>
                    <span style="display:block; font-size:10px; font-weight:600; color:#94a3b8; margin-top:2px;"><%= LoanerCar::PARKING_LOTS[car.parking_lot] %></span>
                  <% end %>
                </td>
                <%
                  rentals_for_car = (@rental_by_car[car.id] || [])
                  consumed = []
                  @grid_dates.each do |date|
                    unless consumed.include?(date)
                      rental = rentals_for_car.find { |r| r.start_date <= date && r.end_date >= date }
                      if rental
                        end_in_grid = [rental.end_date, @grid_end].min
                        span_dates  = (date..end_in_grid).to_a
                        consumed.concat(span_dates)
                %>
                        <td colspan="<%= span_dates.size %>" class="loaner-grid-rented">
                          <%= link_to rental_path(rental), class: "loaner-grid-rental-link" do %>
                            <% display_name = rental.customer_name.presence || rental.repair&.customer_name %>
                            <span class="grid-rental-status"><%= display_name.presence || "貸出中" %></span>
                            <% if rental.reason.present? %>
                              <span class="grid-rental-customer"><%= rental.reason %></span>
                            <% end %>
                          <% end %>
                        </td>
                <%
                      else
                        cell_class = "loaner-grid-empty"
                        cell_class += " grid-today"   if date == Time.zone.today
                        cell_class += " grid-weekend" if date.saturday? || date.sunday?
                %>
                        <td class="<%= cell_class %>"></td>
                <%
                      end
                    end
                  end
                %>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="<%= @grid_dates.size + 1 %>" class="loaner-grid-empty" style="text-align:center; padding: 24px; color: #94a3b8;">
                代車が登録されていません
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

  </div>

  <%# ===== 駐車場タブ ===== %>
  <div id="tab-parking"
       class="tab-content"
       data-panel="parking"
       data-loaner-calendar-target="panel">

    <% today = Time.zone.today %>
    <% (LoanerCar::PARKING_LOTS.keys + ["未設定"]).each do |lot| %>
      <% cars = @cars_by_lot[lot] || [] %>
      <div class="parking-lot-section">
        <div class="parking-lot-header">
          <span class="parking-badge parking-<%= lot %>">
            <%= LoanerCar::PARKING_LOTS[lot] || "未設定" %>
          </span>
          <span class="parking-lot-count"><%= cars.size %>台</span>
        </div>

        <% if cars.any? %>
          <table class="repair-table">
            <thead>
              <tr>
                <th>代車名</th>
                <th>ナンバー</th>
                <th>状況</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% cars.each do |car| %>
                <% active_rental = car.rentals.find { |r| r.start_date <= today && r.end_date >= today } %>
                <tr>
                  <td><%= car.name %></td>
                  <td><%= car.car_number %></td>
                  <td>
                    <% if active_rental %>
                      <span class="status-badge working">貸出中</span>
                    <% else %>
                      <span class="status-badge completed">空き</span>
                    <% end %>
                  </td>
                  <td>
                    <%= link_to "場所変更", edit_loaner_car_path(car), class: "btn-outline btn-sm" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <div class="card empty-state"><p class="muted">この駐車場に登録された代車はありません</p></div>
        <% end %>
      </div>
    <% end %>

  </div>

  <%# ===== 貸出履歴タブ ===== %>
  <div id="tab-history"
       class="tab-content"
       data-panel="history"
       data-loaner-calendar-target="panel">

    <%# 月フィルター %>
    <div class="history-filter">
      <select class="form-input" style="max-width:160px;" onchange="location.href=this.value">
        <% 13.times do |i| %>
          <% m = Time.zone.today.beginning_of_month - i.months %>
          <% val = m.strftime("%Y-%m") %>
          <% label = m.strftime("%Y年%-m月") %>
          <option value="<%= loaner_cars_path(tab: "history", history_month: val) %>"
                  <%= "selected" if @history_month == val %>>
            <%= label %>
          </option>
        <% end %>
      </select>
    </div>

    <% if @all_rentals.any? %>
      <div class="table-scroll">
        <table class="repair-table">
          <thead>
            <tr>
              <th>代車</th>
              <th>顧客</th>
              <th>開始日</th>
              <th>終了日</th>
            </tr>
          </thead>
          <tbody>
            <% @all_rentals.each do |rental| %>
              <tr class="table-row-link" onclick="location.href='<%= rental_path(rental) %>'">
                <td><%= rental.loaner_car.name %></td>
                <td><%= rental.customer_name.presence || rental.repair&.customer_name || "なし" %></td>
                <td><%= rental.start_date.strftime("%Y/%m/%d") %></td>
                <td><%= rental.end_date.strftime("%Y/%m/%d") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <%= paginate @all_rentals, param_name: :history_page,
            params: { tab: "history", history_month: @history_month } %>
    <% else %>
      <div class="card empty-state">
        <p class="muted">この月の貸出記録はありません。</p>
      </div>
    <% end %>

  </div>

</div>
