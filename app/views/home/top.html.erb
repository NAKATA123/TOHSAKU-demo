<h1 class="page-title">ダッシュボード</h1>

<div class="card" style="margin-bottom:24px;">
  <% today = Time.zone.today %>
  <% days_jp = %w[日 月 火 水 木 金 土] %>
  <p class="muted" style="margin:0;">本日</p>
  <p style="margin:6px 0 0; font-weight:800; font-size:16px;">
    <%= today.strftime("%Y/%m/%d") %>
    <span style="font-size:13px; color:#64748b; margin-left:4px;">
      （<%= days_jp[today.wday] %>）
    </span>
  </p>

  <div class="today-notice"
       data-controller="today-notice"
       data-today-notice-notice-id-value="<%= @today_notice.id || 0 %>"
       data-today-notice-notice-date-value="<%= @today_notice.notice_date %>"
       data-today-notice-create-url-value="<%= notices_path %>"
       data-today-notice-update-url-value="<%= @today_notice.persisted? ? notice_path(@today_notice) : "" %>">
    <div class="today-notice-header">
      <p class="today-notice-title">今日の連絡事項</p>
      <span class="today-notice-status" data-today-notice-target="status"></span>
    </div>
    <textarea class="today-notice-input"
              data-today-notice-target="input"
              data-action="input->today-notice#queueSave blur->today-notice#saveNow"
              placeholder="ここを押して入力"><%= @today_notice.content %></textarea>
  </div>
</div>

<h2 class="section-title">代車状況</h2>
<div style="display:grid; grid-template-columns:repeat(2, 1fr); gap:16px; margin-bottom:32px;">
  <div class="card">
    <p class="muted">貸出中</p>
    <p class="stat-number"><%= @loaned_count %></p>
  </div>

  <div class="card">
    <p class="muted">空き台数</p>
    <p class="stat-number"><%= @available_count %></p>
  </div>
</div>

<h2 class="section-title">修理状況</h2>
<div style="display:grid; grid-template-columns:repeat(3, 1fr); gap:16px;">
  <%= link_to repairs_path(status: :reception), class: "card stat-card" do %>
    <p class="muted">受付中</p>
    <p class="stat-number"><%= @reception_count %></p>
  <% end %>

  <%= link_to repairs_path(status: :working), class: "card stat-card" do %>
    <p class="muted">作業中</p>
    <p class="stat-number"><%= @working_count %></p>
  <% end %>

  <%= link_to repairs_path(status: :completed), class: "card stat-card" do %>
    <p class="muted">完了</p>
    <p class="stat-number"><%= @completed_count %></p>
  <% end %>
</div>
